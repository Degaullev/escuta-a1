# ============================================================================
# Escuta A1 (Gemini Edition) — Environment Configuration
# Copy this file to `.env` and set your Gemini API key.
# NEVER commit `.env` or hardcode keys in scripts.
# ============================================================================

GEMINI_API_KEY=your_gemini_api_key_here

# Text / Structured Output Model (e.g. gemini-4-argon, gemini-4-hydrogen, gemini-2.5-pro)
GEMINI_TEXT_MODEL=gemini-4-argon

# Native Multimodal Audio Audit Model
GEMINI_AUDIT_MODEL=gemini-4-argon

# Gemini 3.8 TTS Model (gemini-3.8-flash-tts or gemini-3.8-flash-lite-tts)
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_LITE_MODEL=gemini-3.8-flash-lite-tts

# Visual Generation Models
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image-preview
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview

# Fixed Character Voices
ANA_TTS_VOICE=Aoede
PEDRO_TTS_VOICE=Puck

# Whisper Model Size for Local Acoustic Check (tiny, base, small, medium)
WHISPER_MODEL_SIZE=small
