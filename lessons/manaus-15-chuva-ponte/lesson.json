  "grammarQuizzes": [
    {
      "id": "gq-1",
      "title": "名詞の前の o と a",
      "prompt": "次の3つの文の [ ] に注目しましょう。名詞の性別によって、前の言葉がどう変わるか予測できますか？",
      "examples": [
        {
          "lineId": "line-03",
          "pt": "Vamos para [o] café ali!",
          "ja": "あそこのカフェへ行こう！"
        },
        {
          "lineId": "line-05",
          "pt": "Já vai passar! Olha [o] sol!",
          "ja": "すぐ止むよ！太陽を見て！"
        },
        {
          "lineId": "line-07",
          "pt": "Olha [a] Ponte Rio Negro!",
          "ja": "リオ・ネグロ大橋を見て！"
        }
      ],
      "hint": "café や sol は男性名詞、ponte（橋）は女性名詞です。",
      "ruleTitle": "男性名詞には o、女性名詞には a",
      "explanation": "ポルトガル語の名詞には「男性」と「女性」の区別があります。英語の the にあたる定冠詞は、男性名詞（o café, o sol）には o、女性名詞（a ponte）には a をつけます。"
    },
    {
      "id": "gq-2",
      "title": "「1つの〜」を表す um と uma",
      "prompt": "次の3つの文の [ ] に注目しましょう。同じ「1つの・1枚の」という意味でも、なぜ形が変わるのでしょうか？",
      "examples": [
        {
          "lineId": "line-04",
          "pt": "Eu quero [um] café, por favor.",
          "ja": "コーヒーを1つお願いします。"
        },
        {
          "lineId": "line-09",
          "pt": "Tem [um] barco no rio.",
          "ja": "川に船が1隻いるよ。"
        },
        {
          "lineId": "line-10",
          "pt": "Eu quero tirar [uma] foto!",
          "ja": "写真を1枚撮りたいな！"
        }
      ],
      "hint": "café と barco は男性名詞、foto（写真）は女性名詞です。",
      "ruleTitle": "男性名詞には um、女性名詞には uma",
      "explanation": "「1つの〜（英語の a / an）」を表す不定冠詞も名詞の性別に合わせます。男性名詞（um café, um barco）には um、女性名詞（uma foto）には uma を使います。"
    }
  ],
